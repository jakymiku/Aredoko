<Window
    x:Class="AredokoWinUiBench.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AredokoWinUiBench"
    Title="Aredoko 比較 — WinUI 3">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="315"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Padding="18" Spacing="16">
            <TextBlock Text="Aredoko" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="比較用 · WinUI 3" Opacity="0.7"/>
            <TextBlock Text="ライブラリ" Margin="0,30,0,0" FontWeight="SemiBold"/>
            <Button Content="すべての作品" AutomationProperties.AutomationId="NavAll"/>
            <TextBlock Text="ローカル架空データ専用。GUI方式は未決定。" TextWrapping="Wrap" Opacity="0.7"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="16,20,16,12" MinWidth="320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="ライブラリ" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtCount" Text="— 件" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,18,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtQuery" Header="検索" PlaceholderText="タイトルやタグ…" AutomationProperties.AutomationId="TxtQuery" TextChanged="Query_Changed"/>
                <ComboBox x:Name="CmbKind" Header="種類" Grid.Column="1" SelectedIndex="0" AutomationProperties.AutomationId="CmbKind" SelectionChanged="Kind_Changed">
                    <ComboBoxItem Content="すべて"/><ComboBoxItem Content="本"/>
                    <ComboBoxItem Content="画像"/><ComboBoxItem Content="動画"/><ComboBoxItem Content="音楽"/>
                </ComboBox>
            </Grid>
            <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="検索中…" Margin="0,4,0,8" Opacity="0.7" AutomationProperties.AutomationId="TxtStatus"/>
            <ListView Grid.Row="3" x:Name="ItemList" ItemsSource="{x:Bind Items, Mode=OneWay}" SelectionMode="Single" SelectionChanged="ItemList_SelectionChanged" AutomationProperties.AutomationId="ItemList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MediaRow">
                        <Grid MinHeight="48" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind KindAndTags}" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="BtnPrev" Content="前へ" Click="Prev_Click" AutomationProperties.AutomationId="BtnPrev"/>
                <TextBlock x:Name="TxtPage" Text="1 / 1" VerticalAlignment="Center" AutomationProperties.AutomationId="TxtPage"/>
                <Button x:Name="BtnNext" Content="次へ" Click="Next_Click" AutomationProperties.AutomationId="BtnNext"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Column="2" Padding="20,22" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <TextBlock Text="詳細・タグ編集" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtTitle" Text="作品を選択してください" TextWrapping="WrapWholeWords" FontWeight="SemiBold" AutomationProperties.AutomationId="TxtTitle"/>
                <TextBox x:Name="TxtTags" Header="タグ（カンマ区切り）" AcceptsReturn="True" TextWrapping="Wrap" Height="110" AutomationProperties.AutomationId="TxtTags" TextChanged="Editor_Changed"/>
                <TextBox x:Name="TxtShelf" Header="棚" AutomationProperties.AutomationId="TxtShelf" TextChanged="Editor_Changed"/>
                <CheckBox x:Name="ChkFavorite" Content="お気に入り" AutomationProperties.AutomationId="ChkFavorite" Checked="Editor_Checked" Unchecked="Editor_Checked"/>
                <CheckBox x:Name="ChkReviewed" Content="確認済み" AutomationProperties.AutomationId="ChkReviewed" Checked="Editor_Checked" Unchecked="Editor_Checked"/>
                <Button x:Name="BtnSave" Content="変更を保存" IsEnabled="False" Click="Save_Click" AutomationProperties.AutomationId="BtnSave"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
