# Supplemental license hashes preserve the original upstream bytes.
config/runtime-notices/** -text
config/desktop-notices/*.txt -text whitespace=cr-at-eol,-trailing-space,-blank-at-eof
config/desktop-notices/*.html -text whitespace=cr-at-eol,-trailing-space,-blank-at-eof
