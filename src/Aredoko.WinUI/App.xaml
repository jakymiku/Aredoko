<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Aredoko_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aredoko_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Form fields leave a dedicated lane for overlay scroll bars. -->
            <Thickness x:Key="FormScrollGutter">0,0,24,0</Thickness>
            <!-- Native theme resources also adapt to Windows Contrast themes. -->
            <Style x:Key="ImageViewerOverlayStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="8" />
            </Style>
            <Style x:Key="ImageViewerCanvasStyle" TargetType="ScrollViewer">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
