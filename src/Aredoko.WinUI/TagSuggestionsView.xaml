<UserControl x:Class="Aredoko_WinUI.TagSuggestionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Layout" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.AutomationId="TagStatus" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Grid.Row="1" Spacing="8">
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="Generate" Content="候補を生成" Click="Generate_Click" AutomationProperties.AutomationId="TagGenerate"/>
    <Button x:Name="Refresh" Content="最新へ" Click="Refresh_Click" AutomationProperties.AutomationId="TagRefresh"/>
    <Button x:Name="Older" Content="古い履歴" Click="Older_Click" AutomationProperties.AutomationId="TagOlder"/>
    <Button x:Name="Cancel" Content="中止" Click="Cancel_Click" IsEnabled="False" AutomationProperties.AutomationId="TagCancel"/>
   </StackPanel>
   <ComboBox x:Name="Batches" Header="生成履歴（最大10件ずつ）" HorizontalAlignment="Stretch" SelectionChanged="Batch_Changed" AutomationProperties.AutomationId="TagBatches"/>
  </StackPanel>
  <Grid x:Name="Body" Grid.Row="2" ColumnSpacing="12" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListView x:Name="Candidates" SelectionChanged="Candidate_Changed" SelectionMode="Single" AutomationProperties.AutomationId="TagCandidates" AutomationProperties.Name="AIタグ候補と承認状態"/>
   <ScrollViewer x:Name="Detail" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="TagDetail">
    <StackPanel Spacing="12">
     <Image x:Name="Evidence" Visibility="Collapsed" Height="110" Stretch="Uniform" AutomationProperties.Name="候補を生成した画像または本の先頭ページ" AutomationProperties.AutomationId="TagEvidence"/>
     <TextBlock x:Name="Provenance" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="TagProvenance"/>
     <TextBlock x:Name="Explanation" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="TagExplanation"/>
     <TextBox x:Name="Edited" Header="承認するタグ（修正できます）" MaxLength="60" TextChanged="Edited_Changed" AutomationProperties.AutomationId="TagEdited"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="Accept" Content="承認して保存" Click="Accept_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="TagAccept"/>
      <Button x:Name="Reject" Content="却下" Click="Reject_Click" AutomationProperties.AutomationId="TagReject"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
