         <CheckBox x:Name="UnregisterConsent" HorizontalContentAlignment="Stretch" Checked="UnregisterConsent_Changed" Unchecked="UnregisterConsent_Changed" AutomationProperties.Name="この登録を解除する（元ファイルは残り、再登録でタグと棚が戻ります）" AutomationProperties.AutomationId="UnregisterConsent"><TextBlock Text="この登録を解除する（元ファイルは残り、再登録でタグと棚が戻ります）" TextWrapping="Wrap"/></CheckBox>
         <Button x:Name="UnregisterRoot" Content="選択フォルダの登録を解除" HorizontalAlignment="Stretch" IsEnabled="False" Click="UnregisterRoot_Click" AutomationProperties.AutomationId="UnregisterRoot"/>
