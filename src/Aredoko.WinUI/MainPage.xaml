          <CheckBox x:Name="FillUnsetShelf" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="自分で棚から外した作品も対象" Checked="FolderEditor_Checked" Unchecked="FolderEditor_Checked" AutomationProperties.Name="棚なしの作品にも適用（自分で棚から外した作品も対象）" AutomationProperties.AutomationId="FillUnsetShelf"><TextBlock Text="棚なしの作品にも適用" TextWrapping="Wrap"/></CheckBox>
          <Button x:Name="SaveRootShelf" Content="保存" HorizontalAlignment="Stretch" Click="SaveRootShelf_Click" AutomationProperties.AutomationId="SaveRootShelf"/>
