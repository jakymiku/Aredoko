        <Expander Header="起動時の自動更新" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="RootStartupSection"><StackPanel Spacing="8">
         <ComboBox x:Name="RootStartupScan" Header="起動時の更新" PlaceholderText="複数の設定値" HorizontalAlignment="Stretch" SelectionChanged="RootStartupScan_Changed" AutomationProperties.AutomationId="RootStartupScan" AutomationProperties.Name="起動時の更新">
