<Page x:Class="Aredoko_WinUI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded" SizeChanged="Page_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
 <Page.Resources>
  <DataTemplate x:Key="MediaContainerTemplate"><Border HorizontalAlignment="Stretch"/></DataTemplate>
  <Style x:Key="MediaItemCardStyle" TargetType="ListViewItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
   <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
   <Setter Property="Margin" Value="0,0,8,8"/>
  </Style>
  <Style x:Key="MediaItemSelectedCardStyle" TargetType="ListViewItem" BasedOn="{StaticResource MediaItemCardStyle}">
   <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
   <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style x:Key="MediaPlaceholderIconStyle" TargetType="SymbolIcon"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  <Style x:Key="MediaTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="MediaMetadataStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
 </Page.Resources>
 <Page.KeyboardAccelerators><KeyboardAccelerator Key="Home" Modifiers="Control" Invoked="BrowseEdgeShortcut"/><KeyboardAccelerator Key="End" Modifiers="Control" Invoked="BrowseEdgeShortcut"/><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/><KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveShortcut"/><KeyboardAccelerator Key="Escape" Invoked="CancelSearchShortcut"/><KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="HistoryBackShortcut"/><KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="HistoryForwardShortcut"/></Page.KeyboardAccelerators>
 <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto" IsPaneOpen="False" CompactPaneLength="48" OpenPaneLength="180" SelectionChanged="Nav_SelectionChanged" ItemInvoked="Navigation_ItemInvoked" AutomationProperties.AutomationId="Nav">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="すべて" Tag="all" Icon="Library" IsSelected="True" AutomationProperties.AutomationId="NavAll"/>
   <NavigationViewItem Content="お気に入り" Tag="favorites" Icon="Favorite" AutomationProperties.AutomationId="NavFavorites"/>
   <NavigationViewItem Content="閲覧履歴" Tag="history" Icon="Clock" AutomationProperties.AutomationId="NavHistory"/>
   <NavigationViewItem Content="棚" Tag="shelf" Icon="Folder" AutomationProperties.AutomationId="NavShelf"/>
   <NavigationViewItem x:Name="FolderNavigation" Content="登録フォルダ" Tag="folders" Icon="Folder" AutomationProperties.AutomationId="NavFolders"/>
  </NavigationView.MenuItems>
  <NavigationView.FooterMenuItems><NavigationViewItem Content="設定" Tag="settings" Icon="Setting" SelectsOnInvoked="False" AutomationProperties.AutomationId="BtnSettings"/></NavigationView.FooterMenuItems>
   <SplitView x:Name="Details" PaneOpened="Details_PaneStateChanged" PaneClosed="Details_PaneStateChanged" Margin="16" PanePlacement="Right" DisplayMode="Inline" IsPaneOpen="False" OpenPaneLength="320" PaneBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <SplitView.Pane>
     <Border KeyDown="Detail_KeyDown" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
     <Grid RowSpacing="16" Padding="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="DetailPaneTitle" Text="詳細と整理" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Click="CloseDetails_Click" ToolTipService.ToolTip="詳細を閉じる（Esc）" AutomationProperties.Name="詳細を閉じる" AutomationProperties.AutomationId="BtnCloseDetails"><SymbolIcon Symbol="Cancel"/></Button>
      </Grid>
      <StackPanel x:Name="SelectionSummaryPanel" Grid.Row="1" Visibility="Collapsed" Spacing="12">
       <TextBlock x:Name="SelectionSummaryText" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="SelectionSummaryText"/>
       <TextBlock x:Name="SelectionEditStatus" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="SelectionEditStatus"/>
       <TextBlock Text="選択した作品をまとめて整理できます。個別のタグやプレビューは1件だけ選択すると表示します。" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}"/>
       <Button Content="お気に入りに登録" Click="SelectionFavoriteAdd_Click" AutomationProperties.AutomationId="SelectionFavoriteAdd"/>
       <Button Content="お気に入りを解除" Click="SelectionFavoriteRemove_Click" AutomationProperties.AutomationId="SelectionFavoriteRemove"/>
       <Button Content="棚に追加…" Click="SelectionShelfAdd_Click" AutomationProperties.AutomationId="SelectionShelfAdd"/>
       <Button Content="棚から外す…" Click="SelectionShelfRemove_Click" AutomationProperties.AutomationId="SelectionShelfRemove"/>
      </StackPanel>
      <ContentControl x:Name="Editor" Grid.Row="1" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
       <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="DetailScroll" AutomationProperties.Name="作品の詳細と編集"><StackPanel Spacing="12" Margin="{StaticResource FormScrollGutter}">
      <TextBlock x:Name="ItemTitle" Text="作品を選んでください" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DetailItemTitle"/>
      <TextBlock x:Name="ItemPath" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="DetailItemLocation"/>
      <Image x:Name="DetailPreview" IsDoubleTapEnabled="True" DoubleTapped="DetailPreview_DoubleTapped" Height="160" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="選択作品の表紙" AutomationProperties.AutomationId="DetailPreview"/>
      <StackPanel Spacing="8" AutomationProperties.AutomationId="DetailOpenActions">
       <Button x:Name="OpenImage" Content="画像を大きく表示" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenImage_Click" AutomationProperties.AutomationId="BtnOpenImage"/>
       <Button x:Name="OpenBook" Content="本を開く" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenBook_Click" AutomationProperties.AutomationId="BtnOpenBook"/>
       <Button x:Name="OpenVideo" Content="動画を再生" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenVideo_Click" AutomationProperties.AutomationId="BtnOpenVideo"/>
       <Button x:Name="OpenAudio" Content="音声を再生" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenAudio_Click" AutomationProperties.AutomationId="BtnOpenAudio"/>
      </StackPanel>
      <TextBlock x:Name="AudioSearchHint" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="AudioSearchHint"/>
      <Button x:Name="TagSuggestionsButton" Content="AIタグ候補" Visibility="Collapsed" IsEnabled="False" Click="TagSuggestions_Click" AutomationProperties.AutomationId="BtnTagSuggestions"/>

       <TextBox x:Name="Tags" Header="タグ（カンマ区切り）" TextWrapping="Wrap" MaxHeight="120" TextChanged="Editor_Changed" AutomationProperties.Name="タグ（カンマ区切り）" AutomationProperties.AutomationId="TxtTags"/>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="Shelf" Header="棚" PlaceholderText="棚なし" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="96" AutomationProperties.Name="所属する棚" AutomationProperties.AutomationId="TxtShelf"/>
        <Button x:Name="ChooseShelvesButton" Grid.Column="1" VerticalAlignment="Bottom" Content="変更" ToolTipService.ToolTip="所属する棚を変更" Click="ChooseShelves_Click" AutomationProperties.Name="所属する棚を変更" AutomationProperties.AutomationId="BtnChooseShelves"/>
       </Grid>
       <CheckBox x:Name="Favorite" Content="お気に入り" Checked="Favorite_Checked" Unchecked="Favorite_Checked" AutomationProperties.AutomationId="ChkFavorite"/>
       <CheckBox x:Name="Reviewed" Visibility="Collapsed" Content="確認済み" Checked="Editor_Checked" Unchecked="Editor_Checked" AutomationProperties.AutomationId="ChkReviewed"/>
       <Expander x:Name="FileProperties" Header="ファイルのプロパティ" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="FileProperties"><TextBlock x:Name="FilePropertyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="FilePropertyText"/></Expander>
       </StackPanel></ScrollViewer>
       <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock x:Name="EditStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtEditStatus"/>
       <Button x:Name="Save" Content="保存（Ctrl+S）" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" AutomationProperties.AutomationId="BtnSave"/>
      </StackPanel>
       </Grid></ContentControl>
      <ContentControl x:Name="FolderEditorPanel" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid RowSpacing="12">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="FolderDetailScroll" AutomationProperties.Name="登録フォルダの設定"><StackPanel Spacing="12" Margin="{StaticResource FormScrollGutter}">
        <TextBlock x:Name="FolderTargetTitle" Text="フォルダを選んでください" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtFolderTargetTitle"/>
        <TextBlock x:Name="FolderTargetPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="TxtFolderTargetPath"/>
        <TextBlock x:Name="CurrentShelfSummary" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="TxtCurrentShelfSummary"/>
        <Button Content="棚を選択（複数可）" Click="ChooseRootShelves_Click" AutomationProperties.AutomationId="BtnChooseRootShelves"/>
        <ComboBox x:Name="RootInitialShelf" Header="初期棚（新規登録／選択フォルダの設定）" HorizontalAlignment="Stretch" SelectionChanged="RootInitialShelf_Changed" AutomationProperties.Name="初期棚" AutomationProperties.AutomationId="RootInitialShelf"/>
        <TextBox x:Name="RootNewShelf" Header="新しい棚の名前" MaxLength="80" IsEnabled="False" TextChanged="FolderEditor_Changed" AutomationProperties.Name="新しい棚の名前" AutomationProperties.AutomationId="RootNewShelf"/>
        <TextBlock Text="新しく見つかったファイルをこの棚へ入れます。個別に変更・解除した棚は再スキャンしても保持します。" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
        <CheckBox x:Name="FillUnsetShelf" Content="既存の棚未設定ファイルにも適用（個別に解除した棚を含む）" Checked="FolderEditor_Checked" Unchecked="FolderEditor_Checked" AutomationProperties.AutomationId="FillUnsetShelf"/>
        <Button x:Name="SaveRootShelf" Content="選択フォルダの初期棚を保存" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="SaveRootShelf_Click" AutomationProperties.AutomationId="SaveRootShelf"/>
        <StackPanel x:Name="SingleRootSection" Spacing="12">
         <ComboBox x:Name="ScanModeChoice" Header="スキャン方法" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="スキャン方法" AutomationProperties.AutomationId="ScanModeChoice">
          <ComboBoxItem Content="アイテム一覧だけ取得" Tag="list" AutomationProperties.AutomationId="ScanModeList"/>
          <ComboBoxItem Content="一覧取得＋AI索引を作成" Tag="list_and_ai" AutomationProperties.AutomationId="ScanModeListAndAI"/>
         </ComboBox>
         <TextBox x:Name="RootExcludes" Header="スキャン対象から除外（例: cache, *.tmp）" TextChanged="FolderEditor_Changed" AutomationProperties.Name="除外ルール" AutomationProperties.AutomationId="RootExcludes"/>
         <Button x:Name="SaveExcludes" Content="選択フォルダの除外を更新" HorizontalAlignment="Stretch" Click="SaveExcludes_Click" AutomationProperties.AutomationId="SaveExcludes"/>
         <Button x:Name="ScanRoot" Content="選択フォルダをスキャン / 再開" HorizontalAlignment="Stretch" Click="ScanRoot_Click" AutomationProperties.AutomationId="ScanRoot"/>
         <Button x:Name="CancelScan" Content="スキャンをキャンセル" HorizontalAlignment="Stretch" Click="CancelScan_Click" AutomationProperties.AutomationId="CancelScan"/>
        </StackPanel>
        <ComboBox x:Name="RootStartupScan" Header="起動時の自動スキャン" PlaceholderText="複数の設定値" HorizontalAlignment="Stretch" SelectionChanged="RootStartupScan_Changed" AutomationProperties.AutomationId="RootStartupScan" AutomationProperties.Name="起動時の自動スキャン">
         <ComboBoxItem Content="しない"/><ComboBoxItem Content="アイテム一覧だけ更新"/><ComboBoxItem Content="一覧更新＋AI索引を作成"/>
        </ComboBox>
        <TextBlock Text="変更はすぐ保存され、次回起動の画面表示後から適用します。AIが未準備でも一覧は更新します。" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}"/>
        <StackPanel Spacing="8">
         <TextBlock x:Name="UnregisterTargetText" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="TxtUnregisterTarget"/>
         <CheckBox x:Name="UnregisterConsent" Content="登録解除を許可（元ファイルは残り、再登録でタグ・棚を復元）" Checked="UnregisterConsent_Changed" Unchecked="UnregisterConsent_Changed" AutomationProperties.AutomationId="UnregisterConsent"/>
         <Button x:Name="UnregisterRoot" Content="選択フォルダの登録を解除" HorizontalAlignment="Stretch" IsEnabled="False" Click="UnregisterRoot_Click" AutomationProperties.AutomationId="UnregisterRoot"/>
        </StackPanel>
       </StackPanel></ScrollViewer>
       <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock x:Name="FolderEditStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtFolderEditStatus"/>
        <TextBlock x:Name="ScanStatus" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="ScanStatus"/>
       </StackPanel>
      </Grid></ContentControl>
     </Grid>
     </Border>
    </SplitView.Pane>
  <Grid x:Name="LibraryLayout" SizeChanged="LibraryLayout_SizeChanged" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="LibraryHeader" ColumnSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="HeadingTools" Orientation="Horizontal" Spacing="8" SizeChanged="SearchToolbarPart_SizeChanged">
     <Button x:Name="NavigationBackButton" IsEnabled="False" Click="HistoryBack_Click" ToolTipService.ToolTip="戻る（Alt+←）" AutomationProperties.Name="前の画面に戻る" AutomationProperties.AutomationId="BtnNavigationBack"><SymbolIcon Symbol="Back"/></Button>
     <Button x:Name="NavigationForwardButton" IsEnabled="False" Click="HistoryForward_Click" ToolTipService.ToolTip="進む（Alt+→）" AutomationProperties.Name="次の画面に進む" AutomationProperties.AutomationId="BtnNavigationForward"><SymbolIcon Symbol="Forward"/></Button>
     <TextBlock x:Name="MainViewTitle" SizeChanged="SearchToolbarPart_SizeChanged" Text="ライブラリ" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="LibraryHeading"/>
    </StackPanel>
    <StackPanel x:Name="HeaderCommands" Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" SizeChanged="SearchToolbarPart_SizeChanged">
     <TextBlock x:Name="Count" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="TxtCount"/>
    <StackPanel x:Name="ViewTools" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=SearchTools, Mode=OneWay}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" SizeChanged="SearchToolbarPart_SizeChanged">
    <Button x:Name="LayoutButton" Content="グリッド表示" Click="Layout_Click" AutomationProperties.AutomationId="BtnLayout"/>
    <Button Content="表示サイズ" ToolTipService.ToolTip="Ctrl＋ホイールでも変更できます" AutomationProperties.AutomationId="BtnItemSize">
     <Button.Flyout><Flyout x:Name="ItemSizeFlyout" Placement="Bottom">
      <StackPanel Width="240" Spacing="8">
       <TextBlock Text="アイテムの表示サイズ" Style="{StaticResource BodyStrongTextBlockStyle}"/>
       <Slider x:Name="ItemSizeSlider" Minimum="60" Maximum="180" Value="100" StepFrequency="20" SnapsTo="StepValues" IsThumbToolTipEnabled="False" ValueChanged="ItemSizeSlider_ValueChanged" AutomationProperties.Name="アイテムの表示サイズ（パーセント）" AutomationProperties.AutomationId="ItemSizeSlider"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ItemSizeLabel" Text="100%" VerticalAlignment="Center" AutomationProperties.AutomationId="ItemSizeLabel"/>
        <Button Grid.Column="1" Content="標準に戻す" Click="ResetItemSize_Click" AutomationProperties.AutomationId="BtnResetItemSize"/>
       </Grid>
       <TextBlock Text="一覧上で Ctrl＋ホイールでも変更できます。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
      </StackPanel>
     </Flyout></Button.Flyout>
    </Button>
    <Button x:Name="DetailsButton" Content="詳細" IsEnabled="False" Click="OpenDetails_Click" AutomationProperties.AutomationId="BtnDetails"/>
    </StackPanel>
     <Button x:Name="RootsButton" Content="フォルダ管理" Click="Roots_Click" AutomationProperties.AutomationId="BtnRoots"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="ItemSearchRow" Grid.Row="1" ColumnSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Query" PlaceholderText="ファイル名・タグを検索（Ctrl+F）" ToolTipService.ToolTip="検索する言葉を入力（Ctrl+F）" MaxLength="300" TextChanged="Query_Changed" AutomationProperties.Name="ファイル名・タグ検索" AutomationProperties.AutomationId="TxtQuery"/>
    <StackPanel x:Name="SearchFilterTools" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" SizeChanged="SearchToolbarPart_SizeChanged">
    <ComboBox x:Name="Kind" ToolTipService.ToolTip="表示するファイルの種類" SelectedIndex="0" SelectionChanged="Kind_Changed" MinWidth="116" AutomationProperties.Name="種類" AutomationProperties.AutomationId="CmbKind"><ComboBoxItem Content="すべての種類"/><ComboBoxItem Content="本"/><ComboBoxItem Content="画像"/><ComboBoxItem Content="動画"/><ComboBoxItem Content="音声・音楽"/><ComboBoxItem Content="圧縮ファイル" ToolTipService.ToolTip="ZIP・CBZをまとめて表示"/><ComboBoxItem Content="素材"/></ComboBox>
    <ComboBox x:Name="SearchMode" SelectedIndex="0" SelectionChanged="SearchMode_Changed" MinWidth="116" AutomationProperties.Name="検索方法" AutomationProperties.AutomationId="CmbSearchMode"><ComboBoxItem Content="ファイル名・タグ" AutomationProperties.AutomationId="ModeLiteral"/><ComboBoxItem Content="両方で探す（AI）" AutomationProperties.AutomationId="ModeSemantic"/><ComboBoxItem Content="画像の見た目（AI）" AutomationProperties.AutomationId="ModeVisual"/><ComboBoxItem Content="ファイル名・タグの意味（AI）" AutomationProperties.AutomationId="ModeText"/><ComboBoxItem Content="未承認タグ候補" AutomationProperties.AutomationId="ModeTagCandidates"/><ComboBoxItem Content="ページ本文" AutomationProperties.AutomationId="ModePageText"/><ComboBoxItem Content="タグ候補の意味（AI）" AutomationProperties.AutomationId="ModeTagSemantic"/><ComboBoxItem Content="音声の内容（AI）" AutomationProperties.AutomationId="ModeAudioContent"/><ComboBoxItem Content="動画の内容（AI）" AutomationProperties.AutomationId="ModeVideoContent"/><ComboBoxItem Content="動画内の音声（AI）" AutomationProperties.AutomationId="ModeVideoAudioContent"/></ComboBox>
    </StackPanel>
    <Button Grid.Column="2" x:Name="SearchButton" Content="検索" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="Search_Click" AutomationProperties.AutomationId="BtnSearch"/>
    <Button Grid.Column="3" x:Name="CancelSearchButton" Content="中断" VerticalAlignment="Bottom" Visibility="Collapsed" Click="CancelSearch_Click" AutomationProperties.Name="検索中断" AutomationProperties.AutomationId="BtnCancelSearch"/>
   </Grid>
   <Grid x:Name="SearchTools" Grid.Row="2" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <InfoBar x:Name="StartupUpdateBar" Grid.Row="4" Grid.ColumnSpan="2" IsOpen="False" IsClosable="True" Margin="0,8,0,0" AutomationProperties.AutomationId="StartupUpdateBar">
     <InfoBar.ActionButton><Button x:Name="StartupUpdateAction" Content="停止" Click="StartupUpdateAction_Click" AutomationProperties.AutomationId="StartupUpdateAction"/></InfoBar.ActionButton>
    </InfoBar>
    <Grid x:Name="ActiveSearchScopeBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ColumnSpacing="8" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ActiveSearchScopeText" Text="検索対象フィルタがオンになっています" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtActiveSearchScope"/>
     <Button Grid.Column="1" x:Name="ResetAllFoldersButton" Content="解除" Click="ResetAllFolders_Click" AutomationProperties.Name="検索対象フォルダのフィルタを解除" AutomationProperties.AutomationId="BtnResetAllFolders"/>
    </Grid>
    <Expander x:Name="SearchOptions" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Header="AI候補の表示" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ExpandSearchOptions">
     <StackPanel Spacing="8">

    <ComboBox x:Name="SearchRoot" Visibility="Collapsed" Header="単一フォルダで素早く切替（サブフォルダを含む）" HorizontalAlignment="Stretch" SelectionChanged="SearchRoot_Changed" AutomationProperties.Name="検索フォルダ" AutomationProperties.AutomationId="CmbSearchRoot"/>
    <CheckBox x:Name="UnreviewedOnly" Visibility="Collapsed" Content="未確認のアイテムだけを表示" Checked="UnreviewedOnly_Changed" Unchecked="UnreviewedOnly_Changed" AutomationProperties.AutomationId="ChkUnreviewedOnly"/>
    <CheckBox x:Name="AIMatchedOnly" Content="ファイル名・タグで全語一致の候補のみ" Visibility="Collapsed" Checked="AIMatchedOnly_Changed" Unchecked="AIMatchedOnly_Changed" AutomationProperties.Name="AI候補をファイル名・タグの全語一致で絞る" AutomationProperties.AutomationId="ChkAIMatchedOnly"/>
    <NumberBox x:Name="SimilarityBoundary" Header="類似度の区切り（空欄＝自動）" Minimum="-1" Maximum="1" Visibility="Collapsed" ValueChanged="SimilarityBoundary_Changed" AutomationProperties.Name="類似度の区切り" AutomationProperties.AutomationId="NumSimilarityBoundary"/>
    <ComboBox x:Name="AIResultGroup" Header="AI候補の表示" SelectedIndex="0" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="AIResultGroup_Changed" AutomationProperties.AutomationId="CmbAIResultGroup" AutomationProperties.Name="AI候補の表示"><ComboBoxItem Content="上位の類似候補"/><ComboBoxItem Content="その他の参考候補"/><ComboBoxItem Content="すべてのAI候補"/></ComboBox>
     <TextBlock x:Name="SearchMethodHint" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="TxtSearchMethodHint"/>
     </StackPanel>
    </Expander>
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Spacing="4">
     <StackPanel x:Name="ShelfScopeBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
      <Button Content="棚一覧" Click="ShelfList_Click" AutomationProperties.AutomationId="BtnShelfList"/>
      <TextBlock x:Name="ShelfScopeText" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TxtShelfScope"/>
      <Button Content="解除" Click="ClearShelfScope_Click" AutomationProperties.Name="棚の検索条件を解除" AutomationProperties.AutomationId="BtnClearShelfScope"/>
     </StackPanel>
     <Grid x:Name="SimilarityBar" ColumnSpacing="12" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SimilarityTitle" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TxtSimilarityOrigin"/>
      <Button Grid.Column="1" Content="元の検索に戻る" ToolTipService.ToolTip="類似検索の取得中は中断し、元の検索条件へ戻ります。" Click="SimilarityBack_Click" AutomationProperties.AutomationId="BtnSimilarityBack"/>
     </Grid>
    </StackPanel>
   </Grid>

    <Grid x:Name="ItemListContainer" SizeChanged="ItemListContainer_SizeChanged" Grid.Row="3" Margin="0,0,12,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Expander x:Name="FavoriteRootArea" Header="お気に入りのフォルダ" IsExpanded="True" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.AutomationId="FavoriteRootArea">
      <ListView x:Name="FavoriteRootList" MaxHeight="144" SelectionMode="None" IsItemClickEnabled="True" ItemClick="FavoriteRoot_ItemClick" ContainerContentChanging="FavoriteRoot_ContainerContentChanging" ItemTemplate="{StaticResource MediaContainerTemplate}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="お気に入りの登録フォルダ" AutomationProperties.AutomationId="FavoriteRootList"/>
     </Expander>
     <Grid x:Name="SelectionTools" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="8" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" AutomationProperties.AutomationId="SelectionCountText"/>
      <Button x:Name="ClearSelectionButton" Grid.Column="1" Content="選択を解除" Click="ClearLibrarySelection_Click" AutomationProperties.AutomationId="ClearLibrarySelection"/>
      <Button x:Name="CancelSelectionPreparation" Grid.Column="2" Content="選択の準備を中止" Click="CancelSelectionPreparation_Click" Visibility="Collapsed" AutomationProperties.AutomationId="CancelSelectionPreparation"/>
      <TextBlock x:Name="SelectionInlineStatus" Grid.Column="3" Visibility="Collapsed" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="SelectionInlineStatus" AutomationProperties.LiveSetting="Polite"/>
     </Grid>
     <ListView x:Name="Items" Grid.Row="2" SelectionMode="Extended" Loaded="Items_Loaded" ItemContainerStyle="{StaticResource MediaItemCardStyle}" ItemTemplate="{StaticResource MediaContainerTemplate}" ContainerContentChanging="Items_ContainerContentChanging" SelectionChanged="Items_Changed" HorizontalContentAlignment="Stretch" AutomationProperties.Name="作品一覧" AutomationProperties.HelpText="Ctrl/Shiftで複数選択（最大256件）、Ctrl+Homeで先頭、Ctrl+Endで末尾へ移動" AutomationProperties.AutomationId="ItemList"/>
     <StackPanel Grid.Row="2" Spacing="12" Margin="24" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=Empty}">
      <Image x:Name="EmptyArt" Width="128" Height="112" Stretch="Uniform" Source="ms-appx:///Assets/Visual/aredoko_state_no_results_512.png" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
      <TextBlock x:Name="Empty" AutomationProperties.AutomationId="TxtEmpty" AutomationProperties.Name="案内メッセージ" AutomationProperties.LiveSetting="Polite" Text="フォルダを登録すると、ここに作品が並びます。" TextWrapping="Wrap" TextAlignment="Center"/>
     </StackPanel>
     <ScrollViewer x:Name="GettingStarted" Grid.Row="1" Visibility="Collapsed" MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="GettingStarted">
      <StackPanel Margin="24,8,24,12" Spacing="8">
        <Image Source="ms-appx:///Assets/Visual/aredoko_mascot_greeting_512.png" Width="72" Height="64" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
       <TextBlock Text="Aredokoへようこそ" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
       <TextBlock x:Name="GettingStartedSummaryText" Text="フォルダを登録し、「アイテム一覧だけ取得」で始めましょう。ファイル名・タグ検索と閲覧はAIなしで使えます。" TextWrapping="Wrap" AutomationProperties.AutomationId="GettingStartedSummaryText"/>
       <Border Style="{StaticResource AredokoSurfaceStyle}">
        <StackPanel Spacing="4">
         <TextBlock Text="はじめる手順（3ステップ）" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15"/>
         <TextBlock x:Name="GettingStartedStep1Text" Text="1. フォルダを登録 — ここから開始" TextWrapping="Wrap" AutomationProperties.AutomationId="GettingStartedStep1Text"/>
         <TextBlock x:Name="GettingStartedStep2Text" Text="2. 一覧を読み込む — 登録後に実行" TextWrapping="Wrap" AutomationProperties.AutomationId="GettingStartedStep2Text"/>
         <TextBlock x:Name="GettingStartedStep3Text" Text="3. AI検索（任意） — 後から設定できます" TextWrapping="Wrap" AutomationProperties.AutomationId="GettingStartedStep3Text"/>
        </StackPanel>
       </Border>
       <Button x:Name="GettingStartedFolders" Content="フォルダを登録する" Style="{StaticResource AccentButtonStyle}" Click="GettingStartedFolders_Click" AutomationProperties.AutomationId="GettingStartedFolders"/>
       <TextBlock Text="情景や音の内容から探すには、モデル・実行環境とAI索引を追加します。元ファイルは変更しません。" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="GettingStartedAI" Content="使いたいAI機能から準備（任意）" Click="GettingStartedAIPlan_Click" AutomationProperties.AutomationId="GettingStartedAI"/>
        <Button x:Name="GettingStartedHelp" Content="基本的な使い方を見る" Click="GettingStartedHelp_Click" AutomationProperties.AutomationId="GettingStartedGuide"/>
        <Button x:Name="GettingStartedDismiss" Content="この案内を閉じる" Click="GettingStartedDismiss_Click" AutomationProperties.AutomationId="GettingStartedDismiss"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="ShelfHubView" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="棚を作成" Click="CreateShelf_Click" AutomationProperties.AutomationId="BtnCreateShelf"/>
      <Button Content="更新" Click="RefreshShelves_Click" AutomationProperties.AutomationId="BtnRefreshShelves"/>
      <Button x:Name="ShelfLayoutButton" Content="グリッド表示" Click="Layout_Click" AutomationProperties.AutomationId="BtnShelfLayout"/>
      <Button Content="表示サイズ" Click="ShelfSize_Click" AutomationProperties.AutomationId="BtnShelfSize"/>
     </StackPanel>
     <TextBlock x:Name="ShelfHubMessage" Grid.Row="1" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="TxtShelfHubMessage"/>
     <ListView x:Name="ShelfList" SizeChanged="ShelfList_SizeChanged" PointerWheelChanged="Library_PointerWheelChanged" ItemTemplate="{StaticResource MediaContainerTemplate}" ItemContainerStyle="{StaticResource MediaItemCardStyle}" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ShelfList_ItemClick" ContainerContentChanging="ShelfList_ContainerContentChanging" HorizontalContentAlignment="Stretch" AutomationProperties.Name="棚一覧" AutomationProperties.AutomationId="ShelfList"/>
    </Grid>
    <Grid x:Name="FolderHubView" SizeChanged="FolderHub_SizeChanged" AllowDrop="True" DragOver="Folder_DragOver" Drop="Folder_Drop" Grid.Row="1" Grid.RowSpan="3" Margin="0,0,12,0" Visibility="Collapsed" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid x:Name="FolderHeader" ColumnSpacing="8" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="FolderFilterBox" Header="登録フォルダを絞り込む" PlaceholderText="フォルダ名・パスで絞り込み" MaxLength="260" TextChanged="FolderFilter_Changed" AutomationProperties.Name="登録フォルダを名前・パスで絞り込み" AutomationProperties.AutomationId="TxtFolderFilter"/>
      <ComboBox x:Name="FolderStateFilter" Grid.Column="1" Header="表示状態" SelectedIndex="0" SelectionChanged="FolderStateFilter_Changed" MinWidth="136" AutomationProperties.Name="登録フォルダの表示状態" AutomationProperties.AutomationId="CmbFolderState">
       <ComboBoxItem Content="登録中のみ" AutomationProperties.AutomationId="FolderStateActive"/>
       <ComboBoxItem Content="すべて（解除済み含む）" AutomationProperties.AutomationId="FolderStateAll"/>
       <ComboBoxItem Content="登録解除済みのみ" AutomationProperties.AutomationId="FolderStateInactive"/>
       <ComboBoxItem Content="お気に入り（登録中）" AutomationProperties.AutomationId="FolderStateFavorite"/>
      </ComboBox>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
       <Button x:Name="FolderLayoutButton" Content="グリッド表示" Click="FolderLayout_Click" AutomationProperties.AutomationId="BtnFolderLayout"/>
       <Button x:Name="ToggleAddFolderButton" Content="フォルダを追加" Click="ToggleAddFolder_Click" AutomationProperties.AutomationId="BtnToggleAddFolder"/>
      </StackPanel>
     </Grid>
     <Border x:Name="FolderAddPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource AredokoSurfaceStyle}">
      <ScrollViewer x:Name="FolderAddScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="フォルダ登録の入力項目" AutomationProperties.AutomationId="FolderAddScroll">
      <StackPanel Spacing="8" Margin="{StaticResource FormScrollGutter}">
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="RootPath" Header="追加・再登録するフォルダ" PlaceholderText="選択するか、絶対パスを入力" AutomationProperties.Name="追加するフォルダ" AutomationProperties.AutomationId="RootPath"/>
        <Button x:Name="ChooseFolder" Grid.Column="1" VerticalAlignment="Bottom" Content="フォルダを選ぶ" Click="ChooseFolder_Click" AutomationProperties.AutomationId="ChooseFolder"/>
       </Grid>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBox x:Name="AddRootExcludes" Header="除外ルール" PlaceholderText="cache, *.tmp" ToolTipService.ToolTip="除外する名前・パターンをカンマ区切りで指定" AutomationProperties.Name="新規登録の除外ルール" AutomationProperties.AutomationId="AddRootExcludes"/>
        <ComboBox x:Name="AddRootInitialShelf" Grid.Column="1" Header="初期棚" ToolTipService.ToolTip="新規ファイルに設定する棚" HorizontalAlignment="Stretch" SelectionChanged="AddRootInitialShelf_Changed" AutomationProperties.Name="新規登録の初期棚" AutomationProperties.AutomationId="AddRootInitialShelf"/>
        <TextBox x:Name="AddRootNewShelf" Grid.Column="2" Header="新しい棚の名前" MaxLength="80" IsEnabled="False" AutomationProperties.Name="新規登録の新しい棚の名前" AutomationProperties.AutomationId="AddRootNewShelf"/>
       </Grid>
       <CheckBox x:Name="RootRecursive" Content="サブフォルダを含める" IsChecked="True" AutomationProperties.AutomationId="RootRecursive"/>
       <CheckBox x:Name="RootFolderBooks" HorizontalContentAlignment="Stretch" AutomationProperties.Name="画像フォルダを一冊として扱う" AutomationProperties.AutomationId="RootFolderBooks"><TextBlock Text="画像フォルダを一冊として扱う（フォルダ直下の画像をまとめて1冊にします。素材やバラの画像には使わないでください。スキャン後は変更できません）" TextWrapping="Wrap"/></CheckBox>
       <StackPanel Orientation="Horizontal" Spacing="12">

        <Button x:Name="AddRoot" Content="登録" Style="{StaticResource AccentButtonStyle}" Click="AddRoot_Click" AutomationProperties.AutomationId="AddRoot"/>
       </StackPanel>
      </StackPanel></ScrollViewer>
     </Border>
     <Border x:Name="FolderSelectionPanel" Grid.Row="2" Style="{StaticResource AredokoSurfaceStyle}">
      <StackPanel Spacing="8">
       <TextBlock x:Name="FolderSelectionSummary" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtFolderSelectionSummary"/>
       <Grid x:Name="FolderSelectionButtons" ColumnSpacing="8" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="SearchSelectedFoldersButton" Grid.Column="0" Content="選択したフォルダを検索" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="SearchSelectedFolders_Click" AutomationProperties.AutomationId="BtnSearchSelectedFolders"/>
       <Button x:Name="EditSelectedFoldersButton" Grid.Column="1" Content="設定" IsEnabled="False" Click="EditSelectedFolders_Click" AutomationProperties.AutomationId="BtnEditSelectedFolders"/>
       <Button x:Name="UnregisterSelectedFoldersButton" Grid.Column="2" Content="登録解除" IsEnabled="False" Click="UnregisterSelectedFolders_Click" AutomationProperties.AutomationId="BtnUnregisterSelectedFolders"/>
       <Button x:Name="SearchAllFoldersButton" Grid.Column="3" Margin="16,0,0,0" Content="全登録フォルダを検索" Click="ResetAllFolders_Click" AutomationProperties.AutomationId="BtnSearchAllFolders"/>
       </Grid>
      </StackPanel>
     </Border>
     <Grid Grid.Row="3">
      <ListView x:Name="FolderList" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="登録フォルダ一覧" AutomationProperties.AutomationId="FolderList"/>
      <TextBlock x:Name="FolderEmpty" Text="条件に一致する登録フォルダはありません。「フォルダを追加」から登録できます。" Visibility="Collapsed" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="TxtFolderEmpty"/>
     </Grid>
    </Grid>
   <StackPanel Grid.Row="4" Spacing="8">
    <StackPanel x:Name="ItemPagerRow" Orientation="Horizontal" Spacing="8"><Button x:Name="Previous" Content="前へ" Click="Previous_Click" AutomationProperties.AutomationId="BtnPrevious"/><TextBlock x:Name="PageNumber" AutomationProperties.AutomationId="TxtPageNumber" VerticalAlignment="Center"/><Button x:Name="Next" Content="次へ" Click="Next_Click" AutomationProperties.AutomationId="BtnNext"/><Button Content="再接続" Click="Reconnect_Click" AutomationProperties.AutomationId="BtnReconnect"/></StackPanel>
    <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
    <InfoBar x:Name="Status" IsOpen="False" IsClosable="False" Title="接続準備中" AutomationProperties.AutomationId="StatusBar" AutomationProperties.Name="ステータス通知">
     <InfoBar.ActionButton><Button x:Name="StatusMore" Content="説明" Visibility="Collapsed" AutomationProperties.Name="検索結果の説明を読む" AutomationProperties.AutomationId="BtnStatusDetails">
      <Button.Flyout><Flyout>
       <ScrollViewer MaxHeight="300" MaxWidth="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="StatusExplanation" Margin="{StaticResource FormScrollGutter}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="TxtStatusDetails"/></ScrollViewer>
      </Flyout></Button.Flyout>
     </Button></InfoBar.ActionButton>
    </InfoBar>
   </StackPanel>
   <Border x:Name="RuntimeVerifyCard" Grid.RowSpan="5" Canvas.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" Padding="14,10" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" MaxWidth="360" Visibility="Collapsed" AutomationProperties.AutomationId="RuntimeVerifyCard" AutomationProperties.Name="AI環境の準備状況">
    <StackPanel Spacing="6">
     <TextBlock x:Name="RuntimeVerifyTitle" Text="AI環境の整合性を検証中…" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuntimeVerifyTitle"/>
     <ProgressBar x:Name="RuntimeVerifyProgress" Minimum="0" Maximum="100" Width="280" IsIndeterminate="True" AutomationProperties.AutomationId="RuntimeVerifyProgress"/>
     <TextBlock x:Name="RuntimeVerifyDetail" Text="ファイルを走査しています…" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuntimeVerifyDetail"/>
    </StackPanel>
   </Border>
  </Grid>
   </SplitView>
 </NavigationView>
</Page>
