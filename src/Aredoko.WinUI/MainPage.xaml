<Page x:Class="Aredoko_WinUI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded" SizeChanged="Page_SizeChanged">
 <Page.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/><KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveShortcut"/></Page.KeyboardAccelerators>
 <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="LeftCompact" IsPaneOpen="False" CompactPaneLength="48" OpenPaneLength="180" SelectionChanged="Nav_SelectionChanged" AutomationProperties.AutomationId="Nav">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="すべて" Tag="all" Icon="Library" IsSelected="True" AutomationProperties.AutomationId="NavAll"/>
   <NavigationViewItem Content="お気に入り" Tag="favorites" Icon="Favorite" AutomationProperties.AutomationId="NavFavorites"/>
   <NavigationViewItem Content="未確認" Tag="unreviewed" Icon="Clock" AutomationProperties.AutomationId="NavUnreviewed"/>
   <NavigationViewItem Content="棚" Tag="shelf" Icon="Folder" AutomationProperties.AutomationId="NavShelf"/>
  </NavigationView.MenuItems>
  <Grid Padding="16" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="ライブラリ" Style="{StaticResource TitleTextBlockStyle}"/>
    <Button Grid.Column="1" Content="フォルダ管理" Click="Roots_Click" AutomationProperties.AutomationId="BtnRoots"/>
   </Grid>
   <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Query" PlaceholderText="名前・タグを検索（Ctrl+F）" MaxLength="300" TextChanged="Query_Changed" AutomationProperties.Name="名前・タグ検索" AutomationProperties.AutomationId="TxtQuery"/>
    <Button Grid.Column="1" Content="検索" Click="Search_Click" AutomationProperties.AutomationId="BtnSearch"/>
   </Grid>
   <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
    <ComboBox x:Name="Kind" SelectedIndex="0" SelectionChanged="Kind_Changed" MinWidth="116" AutomationProperties.Name="種類" AutomationProperties.AutomationId="CmbKind"><ComboBoxItem Content="すべての種類"/><ComboBoxItem Content="本"/><ComboBoxItem Content="画像"/><ComboBoxItem Content="動画"/><ComboBoxItem Content="音楽"/><ComboBoxItem Content="ZIP"/><ComboBoxItem Content="素材"/></ComboBox>
    <Button x:Name="LayoutButton" Content="タイル表示" Click="Layout_Click" AutomationProperties.AutomationId="BtnLayout"/>
    <TextBlock x:Name="Count" VerticalAlignment="Center" AutomationProperties.AutomationId="TxtCount"/>
   </StackPanel>
   <SplitView x:Name="Details" Grid.Row="3" PanePlacement="Right" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="320" PaneBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <SplitView.Pane>
     <ScrollViewer Padding="16"><StackPanel Spacing="12">
      <TextBlock Text="詳細と整理" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <TextBlock x:Name="ItemTitle" Text="作品を選んでください" TextWrapping="Wrap"/>
      <TextBlock x:Name="ItemPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock Text="サムネイル・読書機能は準備中" Style="{StaticResource CaptionTextBlockStyle}"/>
      <ContentControl x:Name="Editor" IsEnabled="False" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
       <TextBox x:Name="Tags" Header="タグ（カンマ区切り）" TextChanged="Editor_Changed" AutomationProperties.AutomationId="TxtTags"/>
       <TextBox x:Name="Shelf" Header="棚" MaxLength="80" TextChanged="Editor_Changed" AutomationProperties.AutomationId="TxtShelf"/>
       <CheckBox x:Name="Favorite" Content="お気に入り" Checked="Editor_Checked" Unchecked="Editor_Checked" AutomationProperties.AutomationId="ChkFavorite"/>
       <CheckBox x:Name="Reviewed" Content="確認済み" Checked="Editor_Checked" Unchecked="Editor_Checked" AutomationProperties.AutomationId="ChkReviewed"/>
       <TextBlock x:Name="EditStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtEditStatus"/>
       <Button x:Name="Save" Content="保存（Ctrl+S）" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" AutomationProperties.AutomationId="BtnSave"/>
      </StackPanel></ContentControl>
      <Button Content="詳細を閉じる" Click="CloseDetails_Click" AutomationProperties.AutomationId="BtnCloseDetails"/>
     </StackPanel></ScrollViewer>
    </SplitView.Pane>
    <Grid Margin="0,0,12,0">
     <ListView x:Name="Items" SelectionChanged="Items_Changed" HorizontalContentAlignment="Stretch" AutomationProperties.Name="作品一覧" AutomationProperties.AutomationId="ItemList"/>
     <TextBlock x:Name="Empty" Text="フォルダ管理からテスト用フォルダを登録してください。" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
   </SplitView>
   <StackPanel Grid.Row="4" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="Previous" Content="前へ" Click="Previous_Click" AutomationProperties.AutomationId="BtnPrevious"/><TextBlock x:Name="PageNumber" VerticalAlignment="Center"/><Button x:Name="Next" Content="次へ" Click="Next_Click" AutomationProperties.AutomationId="BtnNext"/><Button Content="再接続" Click="Reconnect_Click" AutomationProperties.AutomationId="BtnReconnect"/></StackPanel>
    <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
    <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Title="接続準備中" AutomationProperties.AutomationId="StatusBar"/>
   </StackPanel>
  </Grid>
 </NavigationView>
</Page>