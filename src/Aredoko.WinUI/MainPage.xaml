<Page x:Class="Aredoko_WinUI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded" SizeChanged="Page_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
 <Page.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="FavoriteStarBrush" Color="#FFC47100"/>
     <SolidColorBrush x:Key="EvidenceAIBackground" Color="#140067C0"/>
     <SolidColorBrush x:Key="EvidenceAIBorderBrush" Color="#2E0067C0"/>
     <SolidColorBrush x:Key="EvidencePageBackground" Color="#140F7B0F"/>
     <SolidColorBrush x:Key="EvidencePageBorderBrush" Color="#2E0F7B0F"/>
     <SolidColorBrush x:Key="EvidenceWordBackground" Color="#149D5D00"/>
     <SolidColorBrush x:Key="EvidenceWordBorderBrush" Color="#2E9D5D00"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="FavoriteStarBrush" Color="#FFFBBF24"/>
     <SolidColorBrush x:Key="EvidenceAIBackground" Color="#2460CDFF"/>
     <SolidColorBrush x:Key="EvidenceAIBorderBrush" Color="#3D60CDFF"/>
     <SolidColorBrush x:Key="EvidencePageBackground" Color="#246CCB5F"/>
     <SolidColorBrush x:Key="EvidencePageBorderBrush" Color="#3D6CCB5F"/>
     <SolidColorBrush x:Key="EvidenceWordBackground" Color="#24FCE100"/>
     <SolidColorBrush x:Key="EvidenceWordBorderBrush" Color="#3DFCE100"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="FavoriteStarBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
     <SolidColorBrush x:Key="EvidenceAIBackground" Color="Transparent"/>
     <SolidColorBrush x:Key="EvidenceAIBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="EvidencePageBackground" Color="Transparent"/>
     <SolidColorBrush x:Key="EvidencePageBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="EvidenceWordBackground" Color="Transparent"/>
     <SolidColorBrush x:Key="EvidenceWordBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <DataTemplate x:Key="MediaContainerTemplate"><Border HorizontalAlignment="Stretch"/></DataTemplate>
   <Style x:Key="MediaItemCardStyle" TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
   </Style>
   <Style x:Key="MediaItemSelectedCardStyle" TargetType="ListViewItem" BasedOn="{StaticResource MediaItemCardStyle}">
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
   </Style>
   <Style x:Key="MediaPlaceholderIconStyle" TargetType="SymbolIcon"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
   <Style x:Key="MediaTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style x:Key="MediaMetadataStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
   <Style x:Key="CardBadgeBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="EvidenceAIPillStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource EvidenceAIBackground}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource EvidenceAIBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
   </Style>
   <Style x:Key="EvidencePagePillStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource EvidencePageBackground}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource EvidencePageBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
   </Style>
   <Style x:Key="EvidenceWordPillStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource EvidenceWordBackground}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource EvidenceWordBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
   </Style>
   <Style x:Key="ScopePillBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
   </Style>
   <Style x:Key="SelectedSegmentButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
   </Style>
   <Style x:Key="UnselectedSegmentButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Style>
   <Style x:Key="CardFavoriteActiveButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{ThemeResource FavoriteStarBrush}"/>
   </Style>
   <Style x:Key="ThumbPlateStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
   </Style>
   <Style x:Key="MediaKindOverlayPillStyle" TargetType="Border">
    <Setter Property="Background" Value="#B818181C"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="Margin" Value="6"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
   </Style>
   <Style x:Key="TileQuickActionPillStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="2"/>
    <Setter Property="Background" Value="#B818181C"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
   </Style>
   <Style x:Key="AIHeroQueryTextBoxStyle" TargetType="TextBox">
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
   </Style>
   <Style x:Key="SearchSegmentBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="AISearchSegmentBorderStyle" TargetType="Border" BasedOn="{StaticResource SearchSegmentBorderStyle}">
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
   </Style>
  </ResourceDictionary>
 </Page.Resources>
 <Page.KeyboardAccelerators><KeyboardAccelerator Key="Home" Modifiers="Control" Invoked="BrowseEdgeShortcut"/><KeyboardAccelerator Key="End" Modifiers="Control" Invoked="BrowseEdgeShortcut"/><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/><KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveShortcut"/><KeyboardAccelerator Key="Escape" Invoked="CancelSearchShortcut"/><KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="HistoryBackShortcut"/><KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="HistoryForwardShortcut"/></Page.KeyboardAccelerators>
 <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" IsPaneOpen="False" CompactPaneLength="48" OpenPaneLength="180" SelectionChanged="Nav_SelectionChanged" ItemInvoked="Navigation_ItemInvoked" AutomationProperties.AutomationId="Nav">
  <NavigationView.Resources>
   <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
   <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
   <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
  </NavigationView.Resources>
  <NavigationView.MenuItems>
   <NavigationViewItem Content="すべて" Tag="all" Icon="Home" IsSelected="True" AutomationProperties.AutomationId="NavAll"/>
   <NavigationViewItem Content="お気に入り" Tag="favorites" Icon="Favorite" AutomationProperties.AutomationId="NavFavorites"/>
   <NavigationViewItem Content="閲覧履歴" Tag="history" Icon="Clock" AutomationProperties.AutomationId="NavHistory"/>
   <NavigationViewItem Content="棚" Tag="shelf" Icon="Library" AutomationProperties.AutomationId="NavShelf"/>
   <NavigationViewItem x:Name="FolderNavigation" Content="登録フォルダ" Tag="folders" Icon="Folder" AutomationProperties.AutomationId="NavFolders"/>
  </NavigationView.MenuItems>
  <NavigationView.FooterMenuItems>
   <NavigationViewItem x:Name="NavAIStatus" Content="AI：確認中" Tag="ai" AutomationProperties.Name="AI検索の状態と設定" AutomationProperties.AutomationId="BtnNavAIStatus"><NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;"/></NavigationViewItem.Icon></NavigationViewItem>
   <NavigationViewItem x:Name="SettingsNavItem" Content="設定" Tag="settings" Icon="Setting" AutomationProperties.AutomationId="BtnSettings"/>
  </NavigationView.FooterMenuItems>
   <SplitView x:Name="Details" PaneOpened="Details_PaneStateChanged" PaneClosed="Details_PaneStateChanged" Margin="0" PanePlacement="Right" DisplayMode="Inline" IsPaneOpen="False" OpenPaneLength="340" PaneBackground="Transparent">
    <SplitView.Pane>
     <Border x:Name="DetailPaneBorder" KeyDown="Detail_KeyDown" Margin="8,0,12,12" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
     <Grid RowSpacing="16" Padding="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border x:Name="DetailKindBadge" Style="{StaticResource CardBadgeBorderStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="DetailKindBadge">
         <TextBlock x:Name="DetailKindBadgeText" Style="{StaticResource MediaMetadataStyle}"/>
        </Border>
        <TextBlock x:Name="DetailPaneTitle" Text="詳細と整理" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
       </StackPanel>
       <Button Grid.Column="1" Click="CloseDetails_Click" ToolTipService.ToolTip="詳細を閉じる（Esc）" AutomationProperties.Name="詳細を閉じる" AutomationProperties.AutomationId="BtnCloseDetails"><SymbolIcon Symbol="Cancel"/></Button>
      </Grid>
      <ScrollViewer x:Name="SelectionSummaryScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="選択した作品の整理" AutomationProperties.AutomationId="SelectionSummaryScroll">
      <StackPanel x:Name="SelectionSummaryPanel" Spacing="10" Margin="{StaticResource FormScrollGutter}">
       <TextBlock x:Name="SelectionSummaryText" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="SelectionSummaryText"/>
       <TextBlock x:Name="SelectionSummaryDetails" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="SelectionSummaryDetails"/>
       <TextBlock x:Name="SelectionEditStatus" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="SelectionEditStatus"/>
       <TextBlock Visibility="Collapsed" Text="選択した作品をまとめて整理できます。個別のタグやプレビューは1件だけ選択すると表示します。" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}"/>
       <Button Content="★ お気に入りに追加" HorizontalAlignment="Stretch" Click="SelectionFavoriteAdd_Click" AutomationProperties.AutomationId="SelectionFavoriteAdd"/>
       <Button Content="☆ お気に入りを解除" HorizontalAlignment="Stretch" Click="SelectionFavoriteRemove_Click" AutomationProperties.AutomationId="SelectionFavoriteRemove"/>
       <Button Content="📚 棚に追加…" HorizontalAlignment="Stretch" Click="SelectionShelfAdd_Click" AutomationProperties.AutomationId="SelectionShelfAdd"/>
       <Button Content="📚 棚から外す…" HorizontalAlignment="Stretch" Click="SelectionShelfRemove_Click" AutomationProperties.AutomationId="SelectionShelfRemove"/>
       <Button x:Name="SelectionTagSuggestionsButton" Content="✨ AIタグ候補をまとめて生成" HorizontalAlignment="Stretch" Click="SelectionTagSuggestions_Click" AutomationProperties.AutomationId="SelectionTagSuggestions"/>
       <Button x:Name="SelectionSummaryClearButton" Content="選択を解除" HorizontalAlignment="Stretch" Click="ClearLibrarySelection_Click" AutomationProperties.AutomationId="SelectionSummaryClear"/>
      </StackPanel>
      </ScrollViewer>
      <ContentControl x:Name="Editor" Grid.Row="1" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
       <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="DetailScroll" Loaded="DetailScroll_Loaded" SizeChanged="DetailScroll_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="DetailScroll" AutomationProperties.Name="作品の詳細と編集"><StackPanel Spacing="12" Margin="{StaticResource FormScrollGutter}">
      <Image x:Name="DetailPreview" IsDoubleTapEnabled="True" DoubleTapped="DetailPreview_DoubleTapped" Height="200" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="選択作品の表紙" AutomationProperties.AutomationId="DetailPreview"/>
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="ItemTitle" Text="作品を選んでください" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" VerticalAlignment="Center" AutomationProperties.AutomationId="DetailItemTitle"/>
       <ToggleButton x:Name="Favorite" Grid.Column="1" MinWidth="36" Padding="8,4" FontSize="16" Content="☆" ToolTipService.ToolTip="お気に入り（クリックですぐ保存）" Checked="Favorite_Checked" Unchecked="Favorite_Checked" AutomationProperties.Name="お気に入り" AutomationProperties.AutomationId="ChkFavorite">
        <ToggleButton.Resources>
         <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
           <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#14C47100"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#24C47100"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#30C47100"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#FFC47100"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#FFC47100"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFC47100"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFC47100"/>
           </ResourceDictionary>
           <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#20FBBF24"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#30FBBF24"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#40FBBF24"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#FFFBBF24"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#FFFBBF24"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFBBF24"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFBBF24"/>
           </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
         </ResourceDictionary>
        </ToggleButton.Resources>
       </ToggleButton>
      </Grid>
      <TextBlock x:Name="DetailAvailabilityHint" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="DetailAvailabilityHint"/>
      <StackPanel Spacing="8" AutomationProperties.AutomationId="DetailOpenActions">
       <Button x:Name="OpenImage" Content="▶ 画像を開く" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenImage_Click" AutomationProperties.AutomationId="BtnOpenImage"/>
       <Button x:Name="OpenBook" Content="▶ 本を開く" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenBook_Click" AutomationProperties.AutomationId="BtnOpenBook"/>
       <Button x:Name="OpenVideo" Content="▶ 動画を再生" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenVideo_Click" AutomationProperties.AutomationId="BtnOpenVideo"/>
       <Button x:Name="OpenAudio" Content="▶ 音声を再生" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OpenAudio_Click" AutomationProperties.AutomationId="BtnOpenAudio"/>
       <Button x:Name="DetailFindSimilarButton" Content="≈ 似た作品" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" Click="DetailFindSimilar_Click" AutomationProperties.AutomationId="BtnDetailFindSimilar"/>
       <Button x:Name="FilterByActiveTagButton" Content="このタグで絞り込む" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" ToolTipService.ToolTip="この作品の確定タグで一覧を絞り込みます" AutomationProperties.AutomationId="BtnFilterByActiveTag"/>
       <TextBlock x:Name="DetailOpenHint" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="DetailOpenHint"/>
      </StackPanel>
      <TextBlock x:Name="AudioSearchHint" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="AudioSearchHint"/>
      <Expander x:Name="DetailEvidence" Header="一致した理由" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DetailEvidence">
       <TextBlock x:Name="DetailEvidenceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="DetailEvidenceText"/>
      </Expander>
      <StackPanel Spacing="8">
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="タグ" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
        <Button x:Name="TagSuggestionsButton" Grid.Column="1" Content="✨ AI候補" Visibility="Collapsed" IsEnabled="False" Click="TagSuggestions_Click" AutomationProperties.AutomationId="BtnTagSuggestions"/>
       </Grid>
       <ScrollViewer x:Name="ActiveTagChipsScroll" Visibility="Collapsed" MaxHeight="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ActiveTagChipsScroll">
        <StackPanel x:Name="ActiveTagChipsPanel" Spacing="6" AutomationProperties.AutomationId="ActiveTagChipsPanel"/>
       </ScrollViewer>
       <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="Tags" PlaceholderText="＋ タグを追加" ToolTipService.ToolTip="タグを入力してEnterまたは＋（カンマ区切り貼り付け可。Ctrl+Sで保存）" TextWrapping="Wrap" MaxHeight="84" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyDown="Tags_KeyDown" TextChanged="Editor_Changed" AutomationProperties.Name="タグを追加" AutomationProperties.AutomationId="TxtTags"/>
        <Button x:Name="CommitTagInputButton" Grid.Column="1" Content="＋" VerticalAlignment="Top" IsEnabled="False" Click="CommitTagInput_Click" ToolTipService.ToolTip="入力したタグを追加（Enter）" AutomationProperties.Name="タグを追加" AutomationProperties.AutomationId="BtnCommitTagInput"/>
        <Button x:Name="SuggestExistingTagsButton" Grid.Column="2" Content="既存から" VerticalAlignment="Top" Visibility="Collapsed" ToolTipService.ToolTip="一覧にあるタグから選んで追加" AutomationProperties.Name="一覧からタグを追加" AutomationProperties.AutomationId="BtnSuggestExistingTags"/>
       </Grid>
      </StackPanel>
       <StackPanel Spacing="6">
        <Grid ColumnSpacing="6">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="棚" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
         <Button x:Name="ChooseShelvesButton" Grid.Column="1" Content="変更" ToolTipService.ToolTip="所属する棚を変更" Click="ChooseShelves_Click" AutomationProperties.Name="所属する棚を変更" AutomationProperties.AutomationId="BtnChooseShelves"/>
         <Button x:Name="OpenActiveShelvesButton" Grid.Column="2" Content="すべて開く" Visibility="Collapsed" ToolTipService.ToolTip="所属する棚で絞り込む" Click="OpenActiveShelves_Click" AutomationProperties.Name="所属する棚を開く" AutomationProperties.AutomationId="BtnOpenActiveShelves"/>
        </Grid>
        <StackPanel x:Name="ActiveShelfChipsPanel" Spacing="6" AutomationProperties.AutomationId="ActiveShelfChipsPanel"/>
        <TextBox x:Name="Shelf" Visibility="Collapsed" IsReadOnly="True" AutomationProperties.Name="所属する棚" AutomationProperties.AutomationId="TxtShelf"/>
       </StackPanel>
       <CheckBox x:Name="Reviewed" MinWidth="0" Visibility="Collapsed" Content="確認済み" Checked="Editor_Checked" Unchecked="Editor_Checked" AutomationProperties.AutomationId="ChkReviewed"/>
       <TextBlock x:Name="ItemPath" TextWrapping="Wrap" MaxLines="1" FontSize="12" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="DetailItemLocation"/>
       <Expander x:Name="FileProperties" Header="ファイル情報" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="FileProperties">
        <StackPanel Spacing="8">
         <TextBlock x:Name="FilePropertyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="FilePropertyText"/>
         <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="OpenFileLocation" Content="📁 保存場所を開く" HorizontalAlignment="Stretch" IsEnabled="False" Click="OpenFileLocation_Click" AutomationProperties.Name="保存場所を開く" AutomationProperties.AutomationId="OpenFileLocation"/>
          <Button x:Name="CopySelectedFilePath" Grid.Column="1" Content="📋 パスをコピー" HorizontalAlignment="Stretch" IsEnabled="False" Click="CopySelectedFilePath_Click" AutomationProperties.Name="パスをコピー" AutomationProperties.AutomationId="CopySelectedFilePath"/>
         </Grid>
        </StackPanel>
       </Expander>
       </StackPanel></ScrollViewer>
       <Border x:Name="DetailSaveBar" Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="DetailSaveBar">
        <StackPanel Spacing="8">
         <TextBlock x:Name="EditStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtEditStatus"/>
         <Grid x:Name="DetailSaveButtons" ColumnSpacing="8" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="Save" Content="保存" ToolTipService.ToolTip="タグ・棚の変更を保存（Ctrl+S）" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" AutomationProperties.Name="変更を保存" AutomationProperties.AutomationId="BtnSave"/>
          <Button x:Name="RevertEditsButton" Grid.Column="1" Content="元に戻す" Visibility="Collapsed" IsEnabled="False" ToolTipService.ToolTip="未保存の変更を保存前の状態に戻す" Click="RevertEdits_Click" AutomationProperties.Name="未保存の変更を取り消す" AutomationProperties.AutomationId="BtnRevertEdits"/>
         </Grid>
        </StackPanel>
       </Border>
       </Grid></ContentControl>
      <ContentControl x:Name="FolderEditorPanel" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid RowSpacing="12">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="FolderDetailScroll" AutomationProperties.Name="登録フォルダの設定"><StackPanel Spacing="12" Margin="{StaticResource FormScrollGutter}">
        <TextBlock x:Name="FolderTargetTitle" Text="フォルダを選んでください" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtFolderTargetTitle"/>
        <TextBlock x:Name="FolderTargetPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="TxtFolderTargetPath"/>
        <StackPanel x:Name="SingleRootSection" Spacing="12">
         <TextBlock Text="一覧の更新" Style="{StaticResource BodyStrongTextBlockStyle}"/>
