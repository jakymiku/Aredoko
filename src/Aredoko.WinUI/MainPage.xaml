<Page x:Class="Aredoko_WinUI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded" SizeChanged="Page_SizeChanged">
 <Page.Resources>
  <Style x:Key="MediaTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="MediaMetadataStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
 </Page.Resources>
 <Page.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/><KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveShortcut"/></Page.KeyboardAccelerators>
 <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto" IsPaneOpen="False" CompactPaneLength="48" OpenPaneLength="180" SelectionChanged="Nav_SelectionChanged" AutomationProperties.AutomationId="Nav">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="すべて" Tag="all" Icon="Library" IsSelected="True" AutomationProperties.AutomationId="NavAll"/>
   <NavigationViewItem Content="お気に入り" Tag="favorites" Icon="Favorite" AutomationProperties.AutomationId="NavFavorites"/>
   <NavigationViewItem Content="未確認" Tag="unreviewed" Icon="Clock" AutomationProperties.AutomationId="NavUnreviewed"/>
   <NavigationViewItem Content="棚" Tag="shelf" Icon="Folder" AutomationProperties.AutomationId="NavShelf"/>
   <NavigationViewItem x:Name="FolderNavigation" Content="登録フォルダ" Tag="folders" Icon="Folder" AutomationProperties.AutomationId="NavFolders"/>
  </NavigationView.MenuItems>
   <SplitView x:Name="Details" Margin="16" PanePlacement="Right" DisplayMode="Inline" IsPaneOpen="False" OpenPaneLength="320" PaneBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <SplitView.Pane>
     <Border KeyDown="Detail_KeyDown" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
     <Grid RowSpacing="16" Padding="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="DetailPaneTitle" Text="詳細と整理" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Click="CloseDetails_Click" ToolTipService.ToolTip="詳細を閉じる（Esc）" AutomationProperties.Name="詳細を閉じる" AutomationProperties.AutomationId="BtnCloseDetails"><SymbolIcon Symbol="Cancel"/></Button>
      </Grid>
      <ContentControl x:Name="Editor" Grid.Row="1" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
       <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="DetailScroll" AutomationProperties.Name="作品の詳細と編集"><StackPanel Spacing="12">
      <TextBlock x:Name="ItemTitle" Text="作品を選んでください" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="ItemPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Image x:Name="DetailPreview" IsDoubleTapEnabled="True" DoubleTapped="DetailPreview_DoubleTapped" Height="160" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="選択作品の表紙" AutomationProperties.AutomationId="DetailPreview"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Button x:Name="OpenImage" Content="画像を大きく表示" IsEnabled="False" Click="OpenImage_Click" AutomationProperties.AutomationId="BtnOpenImage"/>
       <Button x:Name="OpenVideo" Content="動画を再生" IsEnabled="False" Click="OpenVideo_Click" AutomationProperties.AutomationId="BtnOpenVideo"/>
      </StackPanel>
      <Button x:Name="TagSuggestionsButton" Content="AIタグ候補" IsEnabled="False" Click="TagSuggestions_Click" AutomationProperties.AutomationId="BtnTagSuggestions"/>
      <Button x:Name="OpenBook" Content="本を開く" IsEnabled="False" Click="OpenBook_Click" AutomationProperties.AutomationId="BtnOpenBook"/>

       <TextBox x:Name="Tags" Header="タグ（カンマ区切り）" TextChanged="Editor_Changed" AutomationProperties.Name="タグ（カンマ区切り）" AutomationProperties.AutomationId="TxtTags"/>
       <TextBox x:Name="Shelf" Header="棚" MaxLength="80" TextChanged="Editor_Changed" AutomationProperties.Name="棚" AutomationProperties.AutomationId="TxtShelf"/>
       <CheckBox x:Name="Favorite" Content="お気に入り" Checked="Editor_Checked" Unchecked="Editor_Checked" AutomationProperties.AutomationId="ChkFavorite"/>
       <CheckBox x:Name="Reviewed" Content="確認済み" Checked="Editor_Checked" Unchecked="Editor_Checked" AutomationProperties.AutomationId="ChkReviewed"/>
       </StackPanel></ScrollViewer>
       <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock x:Name="EditStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtEditStatus"/>
       <Button x:Name="Save" Content="保存（Ctrl+S）" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" AutomationProperties.AutomationId="BtnSave"/>
      </StackPanel>
       </Grid></ContentControl>
      <Grid x:Name="FolderEditorPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="FolderDetailScroll" AutomationProperties.Name="登録フォルダの設定"><StackPanel Spacing="12">
        <TextBlock x:Name="FolderTargetTitle" Text="フォルダを選んでください" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtFolderTargetTitle"/>
        <TextBlock x:Name="FolderTargetPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="TxtFolderTargetPath"/>
        <TextBlock x:Name="CurrentShelfSummary" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="TxtCurrentShelfSummary"/>
        <ComboBox x:Name="RootInitialShelf" Header="初期棚（新規登録／選択フォルダの設定）" HorizontalAlignment="Stretch" SelectionChanged="RootInitialShelf_Changed" AutomationProperties.Name="初期棚" AutomationProperties.AutomationId="RootInitialShelf"/>
        <TextBox x:Name="RootNewShelf" Header="新しい棚の名前" MaxLength="80" IsEnabled="False" TextChanged="FolderEditor_Changed" AutomationProperties.Name="新しい棚の名前" AutomationProperties.AutomationId="RootNewShelf"/>
        <TextBlock Text="新しく見つかったファイルをこの棚へ入れます。個別に変更・解除した棚は再スキャンしても保持します。" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
        <CheckBox x:Name="FillUnsetShelf" Content="既存の棚未設定ファイルにも適用（個別に解除した棚を含む）" Checked="FolderEditor_Checked" Unchecked="FolderEditor_Checked" AutomationProperties.AutomationId="FillUnsetShelf"/>
        <Button x:Name="SaveRootShelf" Content="選択フォルダの初期棚を保存" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="SaveRootShelf_Click" AutomationProperties.AutomationId="SaveRootShelf"/>
        <StackPanel x:Name="SingleRootSection" Spacing="12">
         <TextBox x:Name="RootExcludes" Header="索引対象から除外（除外ルール・カンマ区切り、例: cache, *.tmp）" TextChanged="FolderEditor_Changed" AutomationProperties.Name="除外ルール" AutomationProperties.AutomationId="RootExcludes"/>
         <Button x:Name="SaveExcludes" Content="選択フォルダの除外を更新" HorizontalAlignment="Stretch" Click="SaveExcludes_Click" AutomationProperties.AutomationId="SaveExcludes"/>
         <Button x:Name="ScanRoot" Content="選択フォルダをスキャン / 再開" HorizontalAlignment="Stretch" Click="ScanRoot_Click" AutomationProperties.AutomationId="ScanRoot"/>
         <Button x:Name="CancelScan" Content="スキャンをキャンセル" HorizontalAlignment="Stretch" Click="CancelScan_Click" AutomationProperties.AutomationId="CancelScan"/>
        </StackPanel>
        <StackPanel Spacing="8">
         <TextBlock x:Name="UnregisterTargetText" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="TxtUnregisterTarget"/>
         <CheckBox x:Name="UnregisterConsent" Content="登録解除を許可（元ファイルは残り、再登録でタグ・棚を復元）" Checked="UnregisterConsent_Changed" Unchecked="UnregisterConsent_Changed" AutomationProperties.AutomationId="UnregisterConsent"/>
         <Button x:Name="UnregisterRoot" Content="選択フォルダの登録を解除" HorizontalAlignment="Stretch" IsEnabled="False" Click="UnregisterRoot_Click" AutomationProperties.AutomationId="UnregisterRoot"/>
        </StackPanel>
       </StackPanel></ScrollViewer>
       <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock x:Name="FolderEditStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtFolderEditStatus"/>
        <TextBlock x:Name="ScanStatus" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="ScanStatus"/>
       </StackPanel>
      </Grid>
     </Grid>
     </Border>
    </SplitView.Pane>
  <Grid x:Name="LibraryLayout" SizeChanged="LibraryLayout_SizeChanged" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="MainViewTitle" Text="ライブラリ" Style="{StaticResource TitleTextBlockStyle}"/>
    <TextBlock Grid.Column="1" x:Name="Count" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="TxtCount"/>
    <Button Grid.Column="2" x:Name="RootsButton" Content="フォルダ管理" Click="Roots_Click" AutomationProperties.AutomationId="BtnRoots"/>
   </Grid>
   <Grid x:Name="ItemSearchRow" Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Query" Header="探したいもの" PlaceholderText="名前・タグを検索（Ctrl+F）" MaxLength="300" TextChanged="Query_Changed" AutomationProperties.Name="名前・タグ検索" AutomationProperties.AutomationId="TxtQuery"/>
    <Button Grid.Column="1" Content="検索" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="Search_Click" AutomationProperties.AutomationId="BtnSearch"/>
   </Grid>
   <Grid x:Name="SearchTools" Grid.Row="2" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8">
    <ComboBox x:Name="Kind" Header="種類" SelectedIndex="0" SelectionChanged="Kind_Changed" MinWidth="116" AutomationProperties.Name="種類" AutomationProperties.AutomationId="CmbKind"><ComboBoxItem Content="すべての種類"/><ComboBoxItem Content="本"/><ComboBoxItem Content="画像"/><ComboBoxItem Content="動画"/><ComboBoxItem Content="音楽"/><ComboBoxItem Content="ZIP"/><ComboBoxItem Content="素材"/></ComboBox>
    <ComboBox x:Name="SearchMode" Header="検索方法" SelectedIndex="0" SelectionChanged="SearchMode_Changed" MinWidth="116" AutomationProperties.Name="検索方法" AutomationProperties.AutomationId="CmbSearchMode"><ComboBoxItem Content="名前・タグ" AutomationProperties.AutomationId="ModeLiteral"/><ComboBoxItem Content="AI混合" AutomationProperties.AutomationId="ModeSemantic"/><ComboBoxItem Content="AI画像・表紙" AutomationProperties.AutomationId="ModeVisual"/><ComboBoxItem Content="AI文章" AutomationProperties.AutomationId="ModeText"/><ComboBoxItem Content="未承認タグ候補" AutomationProperties.AutomationId="ModeTagCandidates"/></ComboBox>
    </StackPanel>
    <StackPanel x:Name="ViewTools" Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
    <Button Content="AI索引" Click="AI_Click" AutomationProperties.AutomationId="BtnAIIndex"/>
    <Button Content="関連語" Click="RelatedTerms_Click" AutomationProperties.AutomationId="BtnRelatedTerms"/>
    <Button x:Name="LayoutButton" Content="グリッド表示" Click="Layout_Click" AutomationProperties.AutomationId="BtnLayout"/>
    <Button x:Name="DetailsButton" Content="詳細" IsEnabled="False" Click="OpenDetails_Click" AutomationProperties.AutomationId="BtnDetails"/>
    </StackPanel>
    <Expander x:Name="SearchOptions" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Header="検索フォルダ・AI候補の表示" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ExpandSearchOptions">
     <StackPanel Spacing="8">
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ActiveSearchScopeText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtActiveSearchScope"/>
     <Button Grid.Column="1" x:Name="ChangeSearchFoldersButton" Content="フォルダを選択・変更" Click="Roots_Click" AutomationProperties.AutomationId="BtnChangeSearchFolders"/>
     <Button Grid.Column="2" x:Name="ResetAllFoldersButton" Content="全登録フォルダに切替" Visibility="Collapsed" Click="ResetAllFolders_Click" AutomationProperties.AutomationId="BtnResetAllFolders"/>
    </Grid>
    <ComboBox x:Name="SearchRoot" Header="単一フォルダで素早く切替（サブフォルダを含む）" HorizontalAlignment="Stretch" SelectionChanged="SearchRoot_Changed" AutomationProperties.Name="検索フォルダ" AutomationProperties.AutomationId="CmbSearchRoot"/>
    <CheckBox x:Name="AIMatchedOnly" Content="名前・タグで全語一致の候補のみ" Visibility="Collapsed" Checked="AIMatchedOnly_Changed" Unchecked="AIMatchedOnly_Changed" AutomationProperties.Name="AI候補を名前・タグの全語一致で絞る" AutomationProperties.AutomationId="ChkAIMatchedOnly"/>
    <NumberBox x:Name="SimilarityBoundary" Header="類似度の区切り（空欄＝自動）" Minimum="-1" Maximum="1" Visibility="Collapsed" ValueChanged="SimilarityBoundary_Changed" AutomationProperties.Name="類似度の区切り" AutomationProperties.AutomationId="NumSimilarityBoundary"/>
    <ComboBox x:Name="AIResultGroup" Header="AI候補の表示" SelectedIndex="0" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="AIResultGroup_Changed" AutomationProperties.AutomationId="CmbAIResultGroup" AutomationProperties.Name="AI候補の表示"><ComboBoxItem Content="上位の類似候補"/><ComboBoxItem Content="その他の参考候補"/><ComboBoxItem Content="すべてのAI候補"/></ComboBox>
     </StackPanel>
    </Expander>
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Spacing="4">
     <TextBlock x:Name="SearchMethodHint" TextWrapping="Wrap" Style="{StaticResource MediaMetadataStyle}" AutomationProperties.AutomationId="TxtSearchMethodHint"/>
     <Grid x:Name="SimilarityBar" ColumnSpacing="12" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SimilarityTitle" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TxtSimilarityOrigin"/>
      <Button Grid.Column="1" Content="元の検索に戻る（取得中は取消）" Click="SimilarityBack_Click" AutomationProperties.AutomationId="BtnSimilarityBack"/>
     </Grid>
    </StackPanel>
   </Grid>

    <Grid x:Name="ItemListContainer" Grid.Row="3" Margin="0,0,12,0">
     <ListView x:Name="Items" SelectionChanged="Items_Changed" HorizontalContentAlignment="Stretch" AutomationProperties.Name="作品一覧" AutomationProperties.AutomationId="ItemList"/>
     <TextBlock x:Name="Empty" AutomationProperties.AutomationId="TxtEmpty" Text="フォルダを登録すると、ここに作品が並びます。" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <Grid x:Name="FolderHubView" Grid.Row="1" Grid.RowSpan="3" Margin="0,0,12,0" Visibility="Collapsed" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="FolderFilterBox" Header="登録フォルダを絞り込む（作品検索とは別）" PlaceholderText="フォルダ名・パスで絞り込み" MaxLength="260" TextChanged="FolderFilter_Changed" AutomationProperties.Name="登録フォルダを名前・パスで絞り込み" AutomationProperties.AutomationId="TxtFolderFilter"/>
      <ComboBox x:Name="FolderStateFilter" Grid.Column="1" Header="表示状態" SelectedIndex="0" SelectionChanged="FolderStateFilter_Changed" MinWidth="136" AutomationProperties.Name="登録フォルダの表示状態" AutomationProperties.AutomationId="CmbFolderState">
       <ComboBoxItem Content="登録中のみ" AutomationProperties.AutomationId="FolderStateActive"/>
       <ComboBoxItem Content="すべて（解除済み含む）" AutomationProperties.AutomationId="FolderStateAll"/>
       <ComboBoxItem Content="登録解除済みのみ" AutomationProperties.AutomationId="FolderStateInactive"/>
      </ComboBox>
      <Button x:Name="FolderLayoutButton" Grid.Column="2" VerticalAlignment="Bottom" Content="グリッド表示" Click="FolderLayout_Click" AutomationProperties.AutomationId="BtnFolderLayout"/>
      <Button x:Name="ToggleAddFolderButton" Grid.Column="3" VerticalAlignment="Bottom" Content="フォルダを追加" Click="ToggleAddFolder_Click" AutomationProperties.AutomationId="BtnToggleAddFolder"/>
      <Button x:Name="BackToLibraryButton" Grid.Column="4" VerticalAlignment="Bottom" Content="作品一覧へ戻る" Click="BackToLibrary_Click" AutomationProperties.AutomationId="BtnBackToLibrary"/>
     </Grid>
     <Border x:Name="FolderAddPanel" Grid.Row="1" Visibility="Collapsed" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
      <StackPanel Spacing="8">
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="RootPath" Header="追加・再登録するフォルダ" PlaceholderText="選択するか、絶対パスを入力" AutomationProperties.Name="追加するフォルダ" AutomationProperties.AutomationId="RootPath"/>
        <Button x:Name="ChooseFolder" Grid.Column="1" VerticalAlignment="Bottom" Content="フォルダを選ぶ" Click="ChooseFolder_Click" AutomationProperties.AutomationId="ChooseFolder"/>
       </Grid>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBox x:Name="AddRootExcludes" Header="除外ルール（カンマ区切り、例: cache, *.tmp）" AutomationProperties.Name="新規登録の除外ルール" AutomationProperties.AutomationId="AddRootExcludes"/>
        <ComboBox x:Name="AddRootInitialShelf" Grid.Column="1" Header="初期棚（新規ファイルに設定）" HorizontalAlignment="Stretch" SelectionChanged="AddRootInitialShelf_Changed" AutomationProperties.Name="新規登録の初期棚" AutomationProperties.AutomationId="AddRootInitialShelf"/>
        <TextBox x:Name="AddRootNewShelf" Grid.Column="2" Header="新しい棚の名前" MaxLength="80" IsEnabled="False" AutomationProperties.Name="新規登録の新しい棚の名前" AutomationProperties.AutomationId="AddRootNewShelf"/>
       </Grid>
       <CheckBox x:Name="RootFolderBooks" HorizontalContentAlignment="Stretch" AutomationProperties.Name="画像フォルダを一冊として扱う" AutomationProperties.AutomationId="RootFolderBooks"><TextBlock Text="画像フォルダを一冊として扱う（フォルダ直下の画像をまとめて1冊にします。素材やバラの画像には使わないでください。スキャン後は変更できません）" TextWrapping="Wrap"/></CheckBox>
       <StackPanel Orientation="Horizontal" Spacing="12">
        <CheckBox x:Name="RootConsent" Content="このフォルダの読み取り専用登録を許可" AutomationProperties.AutomationId="RootConsent"/>
        <Button x:Name="AddRoot" Content="登録" Style="{StaticResource AccentButtonStyle}" Click="AddRoot_Click" AutomationProperties.AutomationId="AddRoot"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Grid.Row="2" Padding="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="FolderSelectionSummary" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtFolderSelectionSummary"/>
       <Button x:Name="SearchSelectedFoldersButton" Grid.Column="1" Content="選択したフォルダを検索" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="SearchSelectedFolders_Click" AutomationProperties.AutomationId="BtnSearchSelectedFolders"/>
       <Button x:Name="EditSelectedFoldersButton" Grid.Column="2" Content="設定" IsEnabled="False" Click="EditSelectedFolders_Click" AutomationProperties.AutomationId="BtnEditSelectedFolders"/>
       <Button x:Name="UnregisterSelectedFoldersButton" Grid.Column="3" Content="登録解除" IsEnabled="False" Click="UnregisterSelectedFolders_Click" AutomationProperties.AutomationId="BtnUnregisterSelectedFolders"/>
       <Button x:Name="SearchAllFoldersButton" Grid.Column="4" Content="全登録フォルダを検索" Click="ResetAllFolders_Click" AutomationProperties.AutomationId="BtnSearchAllFolders"/>
      </Grid>
     </Border>
     <Grid Grid.Row="3">
      <ListView x:Name="FolderList" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="登録フォルダ一覧" AutomationProperties.AutomationId="FolderList"/>
      <TextBlock x:Name="FolderEmpty" Text="条件に一致する登録フォルダはありません。「フォルダを追加」から登録できます。" Visibility="Collapsed" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="TxtFolderEmpty"/>
     </Grid>
    </Grid>
   <StackPanel Grid.Row="4" Spacing="8">
    <StackPanel x:Name="ItemPagerRow" Orientation="Horizontal" Spacing="8"><Button x:Name="Previous" Content="前へ" Click="Previous_Click" AutomationProperties.AutomationId="BtnPrevious"/><TextBlock x:Name="PageNumber" AutomationProperties.AutomationId="TxtPageNumber" VerticalAlignment="Center"/><Button x:Name="Next" Content="次へ" Click="Next_Click" AutomationProperties.AutomationId="BtnNext"/><Button Content="再接続" Click="Reconnect_Click" AutomationProperties.AutomationId="BtnReconnect"/></StackPanel>
    <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
    <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Title="接続準備中" AutomationProperties.AutomationId="StatusBar"/>
   </StackPanel>
  </Grid>
   </SplitView>
 </NavigationView>
</Page>
