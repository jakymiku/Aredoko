     </StackPanel>
    </Border>
    <Button ToolTipService.ToolTip="表示サイズ（Ctrl＋ホイールでも変更可）" AutomationProperties.Name="表示サイズ" AutomationProperties.AutomationId="BtnItemSize">
     <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="View"/><TextBlock Text="サイズ"/></StackPanel>
     <Button.Flyout><Flyout x:Name="ItemSizeFlyout" Placement="Bottom">
