             <TextBlock x:Name="SettingsAIStep3Status" Text="確認中…" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
            </StackPanel>
           </Border>
          </Grid>
          <TextBlock x:Name="SettingsAINextHint" Text="AIを使わなくても名前・タグで検索できます。" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
          <StackPanel Spacing="8">
           <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SettingsAIIndexButton" Content="AI検索を設定" Style="{StaticResource AccentButtonStyle}" Click="SettingsAIIndex_Click" AutomationProperties.AutomationId="BtnAIIndex"/>
            <Button x:Name="SettingsAIMediaPrepButton" Content="🎬 動画・音声のAIデータ" Click="SettingsAIMediaPrep_Click" AutomationProperties.AutomationId="BtnAIMediaPrep"/>
            <Button x:Name="SettingsAIDownloadTaggerButton" Content="🏷 タグ付けモデルを取得" Click="SettingsAIDownloadTagger_Click" AutomationProperties.AutomationId="BtnAIDownloadTagger"/>
           </StackPanel>
           <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="SettingsAISetupRowLabel" Text="初回セットアップ・再構成：" Style="{StaticResource MediaMetadataStyle}" VerticalAlignment="Center"/>
            <Button x:Name="SettingsAIEnvironmentButton" Content="AIの自動セットアップ" Click="SettingsAIEnvironment_Click" AutomationProperties.AutomationId="BtnAIEnvironment"/>
            <Button x:Name="SettingsAISetupPlanButton" Content="✨ 用途からAI準備を選ぶ" Click="SettingsAISetupPlan_Click" AutomationProperties.AutomationId="BtnAISetupPlan"/>
           </StackPanel>
          </StackPanel>
          <CheckBox x:Name="SettingsVerifyAIRuntimeCheck" IsEnabled="False" Content="起動時にAI環境の整合性を確認する" ToolTipService.ToolTip="破損による起動エラーを防ぐため起動時に確認します" Checked="SettingsInstantPreference_Changed" Unchecked="SettingsInstantPreference_Changed" AutomationProperties.Name="起動時にAI環境の確認を行う" AutomationProperties.AutomationId="ChkVerifyAIRuntime"/>
         </StackPanel>
        </Border>
       </StackPanel>
       <StackPanel x:Name="SettingsSectionGeneral" Spacing="8">
        <TextBlock Text="表示と操作" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Border Style="{StaticResource AredokoSurfaceStyle}">
         <StackPanel Spacing="8">
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,10">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
             <TextBlock Text="テーマ" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="アプリ全体の外観（ライト／ダーク）を切り替えます" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <ComboBox x:Name="SettingsThemeCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" SelectionChanged="SettingsInstantCombo_Changed" AutomationProperties.Name="テーマ" AutomationProperties.AutomationId="SettingsTheme">
             <ComboBoxItem Content="Windowsの設定に合わせる" Tag="system"/>
             <ComboBoxItem Content="ライト" Tag="light"/>
             <ComboBoxItem Content="ダーク" Tag="dark"/>
            </ComboBox>
           </Grid>
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,10">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
             <TextBlock Text="マウスホイール（画像・本）" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="ビューアでホイールを回したときのページ送り方向" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <ComboBox x:Name="SettingsWheelCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" SelectionChanged="SettingsInstantCombo_Changed" AutomationProperties.Name="画像・本表示中のホイール操作" AutomationProperties.AutomationId="SettingsWheel">
             <ComboBoxItem Content="下回しで次へ（標準）" Tag="down"/>
             <ComboBoxItem Content="上回しで次へ" Tag="up"/>
            </ComboBox>
           </Grid>
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,10">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
             <TextBlock Text="ダブルクリック時の動作" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="通常は内蔵ビューアで開きます。オンにすると既定の外部アプリで開きます" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="SettingsDoubleClickCheck" Grid.Column="1" VerticalAlignment="Center" Content="外部アプリで開く" Checked="SettingsInstantPreference_Changed" Unchecked="SettingsInstantPreference_Changed" AutomationProperties.Name="画像をダブルクリックしたとき外部アプリで開く" AutomationProperties.AutomationId="SettingsDoubleClickViewer"/>
           </Grid>
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,10">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
             <TextBlock Text="はじめ方・使い方ガイド" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="基本操作やAI検索の使い方をいつでも確認できます" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="SettingsGettingStartedButton" Grid.Column="1" VerticalAlignment="Center" Content="はじめ方・使い方ガイド" Click="SettingsGettingStarted_Click" AutomationProperties.AutomationId="BtnGettingStarted"/>
           </Grid>
          </Border>
         </StackPanel>
        </Border>
       </StackPanel>
       <StackPanel x:Name="SettingsSectionLibrary" Spacing="8">
        <TextBlock Text="ライブラリと整理" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Border Style="{StaticResource AredokoSurfaceStyle}">
         <StackPanel Spacing="10">
          <Grid ColumnSpacing="8">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Button x:Name="SettingsOpenFoldersButton" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="12,10" Click="SettingsOpenFolders_Click" AutomationProperties.Name="登録フォルダ" AutomationProperties.AutomationId="BtnSettingsOpenFolders">
            <StackPanel Spacing="2">
             <TextBlock Text="📁 登録フォルダ" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="検索するフォルダの追加・更新・除外設定" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
           </Button>
           <Button x:Name="SettingsOpenShelvesButton" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="12,10" Click="SettingsOpenShelves_Click" AutomationProperties.Name="棚一覧" AutomationProperties.AutomationId="BtnSettingsOpenShelves">
            <StackPanel Spacing="2">
             <TextBlock Text="📚 棚一覧" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="棚の作成・名前変更・整理" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
           </Button>
           <Button x:Name="SettingsRelatedTermsButton" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="12,10" Click="SettingsRelatedTerms_Click" AutomationProperties.Name="関連語辞書" AutomationProperties.AutomationId="BtnRelatedTerms">
            <StackPanel Spacing="2">
             <TextBlock Text="💬 関連語辞書" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="同じ意味で探す言葉（言い換え）を登録" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
           </Button>
          </Grid>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,10">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
             <TextBlock Text="閲覧履歴" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="アプリ内に記録された閲覧履歴のみを消去します（元ファイルは消えません）" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="SettingsClearHistoryButton" Grid.Column="1" VerticalAlignment="Center" Content="閲覧履歴をすべて消去…" Click="SettingsClearHistory_Click" AutomationProperties.AutomationId="BtnClearHistory"/>
           </Grid>
          </Border>
         </StackPanel>
        </Border>
       </StackPanel>
       <StackPanel x:Name="SettingsSectionMaintenance" Spacing="8">
        <TextBlock Text="バックアップと診断" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Border Style="{StaticResource AredokoSurfaceStyle}">
         <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="SettingsBackupButton" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="12,10" Click="SettingsBackup_Click" AutomationProperties.Name="バックアップと復元" AutomationProperties.AutomationId="BtnBackupGuide">
           <StackPanel Spacing="2">
            <TextBlock Text="💾 バックアップと復元" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock Text="タグや棚の控えを保存・別フォルダへ復元" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
           </StackPanel>
          </Button>
          <Button x:Name="SettingsDiagnosticsButton" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="12,10" Click="SettingsDiagnostics_Click" AutomationProperties.Name="診断情報" AutomationProperties.AutomationId="BtnDiagnostics">
           <StackPanel Spacing="2">
            <TextBlock Text="📋 診断情報" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock Text="動作環境の確認とサポート用コピー" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
           </StackPanel>
          </Button>
          <Button x:Name="SettingsRuntimeCacheButton" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="12,10" Click="SettingsRuntimeCache_Click" AutomationProperties.Name="一時キャッシュ整理" AutomationProperties.AutomationId="BtnRuntimeCache">
           <StackPanel Spacing="2">
            <TextBlock Text="🧹 一時キャッシュ整理" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock Text="ダウンロード済み一時ファイルの確認・削除" Style="{StaticResource MediaMetadataStyle}" TextWrapping="Wrap"/>
           </StackPanel>
          </Button>
         </Grid>
        </Border>
       </StackPanel>
      </StackPanel>
      </Grid>
     </ScrollViewer>
    </Grid>
   <StackPanel Grid.Row="4" Spacing="6">
    <StackPanel x:Name="FooterSelectionActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
     <Button x:Name="FooterBulkActions" Content="まとめて整理" Click="FooterBulkActions_Click" AutomationProperties.AutomationId="FooterBulkActions"/>
     <Button x:Name="FooterClearSelection" Content="選択を解除" Click="ClearLibrarySelection_Click" AutomationProperties.AutomationId="FooterClearSelection"/>
    </StackPanel>
    <Border x:Name="RuntimeVerifyCard" HorizontalAlignment="Left" Padding="10,4" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed" AutomationProperties.AutomationId="RuntimeVerifyCard" AutomationProperties.Name="AI環境の準備状況">
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="RuntimeVerifyTitle" Text="AIを確認中" Style="{StaticResource MediaMetadataStyle}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="RuntimeVerifyTitle"/>
      <ProgressBar x:Name="RuntimeVerifyProgress" Grid.Column="1" Minimum="0" Maximum="100" Width="120" IsIndeterminate="True" VerticalAlignment="Center" AutomationProperties.AutomationId="RuntimeVerifyProgress"/>
      <TextBlock x:Name="RuntimeVerifyDetail" Grid.Column="2" Text="確認しています…" Style="{StaticResource MediaMetadataStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="RuntimeVerifyDetail"/>
     </Grid>
    </Border>
    <Grid x:Name="ItemPagerRow" ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PageNumber" Grid.Column="0" AutomationProperties.AutomationId="TxtPageNumber" Style="{StaticResource MediaMetadataStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="表示中の件数と全体の件数"/>
     <StackPanel x:Name="FooterPagerButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
      <Button x:Name="FooterPrevButton" Content="◀ 前へ" IsEnabled="False" Click="Previous_Click" AutomationProperties.Name="前の範囲へ" AutomationProperties.AutomationId="BtnFooterPrevious"/>
      <Button x:Name="FooterNextButton" Content="次へ ▶" IsEnabled="False" Click="Next_Click" AutomationProperties.Name="次の範囲へ" AutomationProperties.AutomationId="BtnFooterNext"/>
     </StackPanel>
     <TextBlock x:Name="FooterSelection" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource MediaMetadataStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="FooterSelection"/>
     <Button Grid.Column="3" Content="⋯ その他" Click="BrowseActions_Click" AutomationProperties.Name="一覧の操作" AutomationProperties.AutomationId="BrowseActions" ToolTipService.ToolTip="一覧の更新・範囲移動">
      <Button.Flyout><MenuFlyout x:Name="BrowseActionsFlyout">
       <MenuFlyoutItem x:Name="Previous" Text="前の範囲へ" IsEnabled="False" Click="Previous_Click" AutomationProperties.AutomationId="BtnPrevious"/>
       <MenuFlyoutItem x:Name="Next" Text="次の範囲へ" IsEnabled="False" Click="Next_Click" AutomationProperties.AutomationId="BtnNext"/>
       <MenuFlyoutSeparator/>
       <MenuFlyoutItem x:Name="SelectVisibleItemsMenuItem" Text="表示中をすべて選択" IsEnabled="False" Click="SelectVisibleItems_Click" AutomationProperties.AutomationId="BtnSelectVisibleItems"/>
       <MenuFlyoutItem x:Name="SelectFirstMaxItemsMenuItem" Text="先頭 256 件を選択" Visibility="Collapsed" IsEnabled="False" Click="SelectFirstMaxItems_Click" AutomationProperties.AutomationId="BtnSelectFirstMaxItems"/>
       <MenuFlyoutItem x:Name="SelectRangeSpanMenuItem" Text="ここまで範囲選択" Visibility="Collapsed" IsEnabled="False" Click="SelectRangeSpan_Click" AutomationProperties.AutomationId="BtnSelectRangeSpan"/>
       <MenuFlyoutSeparator/>
       <MenuFlyoutItem Text="最新の状態に更新" Click="Reconnect_Click" AutomationProperties.AutomationId="BtnReconnect"/>
      </MenuFlyout></Button.Flyout>
     </Button>
    </Grid>
    <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
    <InfoBar x:Name="Status" IsOpen="False" IsClosable="False" Title="起動中…" AutomationProperties.AutomationId="StatusBar" AutomationProperties.Name="ステータス通知">
     <InfoBar.ActionButton><Button x:Name="StatusMore" Content="ⓘ 詳しく" Visibility="Collapsed" AutomationProperties.Name="検索結果の説明を読む" AutomationProperties.AutomationId="BtnStatusDetails">
      <Button.Flyout><Flyout>
       <ScrollViewer MaxHeight="300" MaxWidth="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="StatusExplanation" Margin="{StaticResource FormScrollGutter}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="TxtStatusDetails"/></ScrollViewer>
      </Flyout></Button.Flyout>
     </Button></InfoBar.ActionButton>
    </InfoBar>
   </StackPanel>
  </Grid>
  </Border>
   </SplitView>
 </NavigationView>
</Page>
